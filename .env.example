# =============================================================================
# Vitalink environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every variable here is parsed and validated by apps/api/src/config/env.ts at
# import time — the process refuses to start if any required value is missing or
# malformed (PART 3A.5 rule 4, "fail fast on config").
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# ---- Datastores -------------------------------------------------------------
# Ports 27018 and 6380, not the defaults. A locally-installed mongod or redis
# binds the default port on 127.0.0.1, which macOS resolves before Docker's
# wildcard bind, silently shadowing the container. See infra/docker-compose.yml.
MONGO_URI=mongodb://vitalink:vitalink@localhost:27018/vitalink?authSource=admin
REDIS_URL=redis://localhost:6380

# ---- Python compute service -------------------------------------------------
BRAIN_BASE_URL=http://localhost:8000
BRAIN_SHARED_SECRET=change-me-to-a-long-random-string

# ---- Auth (PART 8) ---------------------------------------------------------
# RS256 keypair for access tokens. Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
# Then paste as single lines with \n escapes, or point at the files in dev.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600
JWT_ISSUER=vitalink
JWT_AUDIENCE=vitalink-api

# Google OAuth 2.0 / OIDC, Authorization Code with PKCE.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/callback

# Shared secret used to sign outbound webhooks and verify inbound ones.
WEBHOOK_SIGNING_SECRET=change-me-to-a-long-random-string

# ---- Public data sources (PART 5) ------------------------------------------
# Most sources need no key. These two do, and both are free.
UN_COMTRADE_API_KEY=
DATA_GOV_IN_API_KEY=

# Nominatim's usage policy requires a contactable User-Agent. Put a real address.
NOMINATIM_USER_AGENT=vitalink/0.1 (your-email@example.com)

# ---- LLM (VERIFY stage only — Rule 2: it never produces a number) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# When false, extraction falls back to the deterministic rule-based extractor
# and every alert is tagged accordingly. Never silently fabricates.
LLM_ENABLED=false

# ---- Carriers (PART 6) ------------------------------------------------------
# Absent credentials are legal: the carrier returns UNAVAILABLE / no_credentials.
# It is NEVER given a fabricated price. See Rule 4.

# DSV — the reference adapter. Credentials are your myDSV username/password plus
# the subscription key from your developer.dsv.com profile.
DSV_ENVIRONMENT=demo
DSV_CLIENT_ID=
DSV_CLIENT_SECRET=
DSV_SUBSCRIPTION_KEY=

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_ENVIRONMENT=sandbox

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENVIRONMENT=sandbox

DHL_API_KEY=
DHL_API_SECRET=
DHL_ENVIRONMENT=sandbox

# Tier C: no public self-serve API. Sandbox-only until credentials are arranged.
KUEHNE_NAGEL_API_KEY=
CEVA_API_KEY=

# Development only. CI gate 5 asserts this cannot be true when NODE_ENV=production.
CARRIER_MOCK_MODE=true
# Model 8 (the rate model) is OFF by default. Its output is always ESTIMATED.
RATE_MODEL_ENABLED=false

# Declared, displayed tie-break preference. Empty = no thumb on the scale.
# Example: {"dsv":2.0}
CARRIER_PREFERENCE_JSON={}
