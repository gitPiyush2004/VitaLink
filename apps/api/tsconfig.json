{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@vitalink/contracts": ["../../packages/contracts/src/index.ts"],
      "@vitalink/contracts/*": ["../../packages/contracts/src/*"],
      "@vitalink/connectors": ["../../packages/connectors/src/index.ts"],
      "@vitalink/connectors/*": ["../../packages/connectors/src/*"],
      "@vitalink/graph": ["../../packages/graph/src/index.ts"],
      "@vitalink/graph/*": ["../../packages/graph/src/*"],
      "@config/*": ["src/config/*"],
      "@shared/*": ["src/shared/*"],
      "@modules/*": ["src/modules/*"]
    }
  },
  // Listed rather than globbed. `packages/*` swept in `packages/ui`, which is
  // React and needs `jsx` set — so the API's typecheck failed on a browser
  // package it will never import.
  "include": [
    "src/**/*.ts",
    "../../packages/contracts/src/**/*.ts",
    "../../packages/connectors/src/**/*.ts",
    "../../packages/graph/src/**/*.ts"
  ]
}
